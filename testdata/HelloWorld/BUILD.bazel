load("@rules_java//java:java_binary.bzl", "java_binary")
load("@rules_java//java:java_library.bzl", "java_library")

java_binary(
    name = "HelloWorld",
    srcs = ["HelloWorld.java"],
    main_class = "HelloWorld",
    deps = [":GreetingLib"],
)

java_library(
    name = "GreetingLib",
    srcs = ["Greeting.java"],
)

filegroup(
    name = "all_srcs",
    srcs = glob(["**"]) + ["InhabitedPlanets"],
    visibility = ["//visibility:public"],
)
